global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    # Disable connection reuse to downstream services
    option http-server-close
    # Maximum time to wait for a connection attempt to a downstream server (in milliseconds)
    timeout connect 5000
    # Maximum inactivity time on the client side (in milliseconds)
    timeout client 300000
    # Maximum inactivity time on the server side (in milliseconds)
    timeout server 300000

{% for port in haproxy_ports %}
frontend ft_{{ port }}
    bind *:{{ port }}
    default_backend bk_{{ port }}

backend bk_{{ port }}
    # Disable persistent connections to downstream server
    option http-server-close
    server target_{{ port }} {{ haproxy_target_ip }}:{{ port }}

{% endfor %}
